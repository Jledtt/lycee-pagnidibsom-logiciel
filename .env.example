APP_NAME="LPP Gestion Scolaire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Ouagadougou

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local simple : SQLite
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Serveur MySQL ou MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lpp_gestion
# DB_USERNAME=lpp_user
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Serveur PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=lpp_gestion
# DB_USERNAME=lpp_user
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TIMETABLE_SOLVER_PYTHON=
TIMETABLE_SOLVER_SCRIPT=
TIMETABLE_SOLVER_TIME_LIMIT=12
MAIL_FROM_ADDRESS="notifications@gestion.lyceepagnidibsom.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications metier par email
LPP_MAIL_NOTIFICATIONS_ENABLED=true
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000
RESEND_DAILY_RESERVE=5

# Sauvegardes automatiques Spatie Backup
LPP_BACKUP_NAME=lpp-gestion-scolaire
LPP_BACKUP_DISKS=local
LPP_BACKUP_TIME=22:00
LPP_BACKUP_MONITOR_TIME=22:15
LPP_BACKUP_CLEAN_TIME=22:30
LPP_BACKUP_MAIL_TO=infoslyceepagnidibsom@gmail.com
LPP_BACKUP_MAX_AGE_DAYS=2
LPP_BACKUP_MAX_STORAGE_MB=5000
LPP_BACKUP_VERIFY=true
LPP_BACKUP_TRIES=2
LPP_BACKUP_RETRY_DELAY=60
LPP_BACKUP_KEEP_ALL_DAYS=7
LPP_BACKUP_KEEP_DAILY_DAYS=16
LPP_BACKUP_KEEP_WEEKLY_WEEKS=8
LPP_BACKUP_KEEP_MONTHLY_MONTHS=4
LPP_BACKUP_KEEP_YEARLY_YEARS=2
LPP_BACKUP_DELETE_WHEN_OVER_MB=5000
BACKUP_ARCHIVE_PASSWORD=

# Copie distante S3 compatible (OVH Object Storage, AWS S3, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bouton Exporter sauvegarde dans l'application
LPP_BACKUP_KEEP_DAYS=14
# LPP_BACKUP_PATH=/chemin/vers/dossier/sauvegardes

# Chemins optionnels si mysqldump/pg_dump/sqlite3 ne sont pas dans le PATH du serveur
# DB_DUMP_BINARY_PATH=/usr/bin
# MYSQL_DUMP_BINARY_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin
# MARIADB_DUMP_BINARY_PATH=C:\laragon\bin\mariadb\mariadb-11\bin
# PGSQL_DUMP_BINARY_PATH=C:\laragon\bin\postgresql\postgresql-16\bin
# SQLITE_DUMP_BINARY_PATH=C:\laragon\bin\sqlite
# Anciennes variables encore acceptees par le bouton d'export manuel
# LPP_MYSQLDUMP_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe
# LPP_PGDUMP_PATH=/usr/bin/pg_dump

# Journal d'audit
ACTIVITY_LOGGER_DEFAULT_LOG_NAME=lpp
ACTIVITY_LOGGER_DELETE_RECORDS_OLDER_THAN_DAYS=730

VITE_APP_NAME="${APP_NAME}"
